+            while self.running:
+                epoch = self.stw_epoch
+                want_park = self.paused or epoch > self.epoch
+                if not want_park:
+                    break
+                if not parked:
+                    self.acks.add((mutator.tid, epoch))
+                    self.stop_cond.notify_all()
+                    parked = True
+                    mutator.parked = True
+                self.stop_cond.wait(timeout=0.25)
+        mutator.parked = False
+        return self.running
