+            "marking": marking,
+            "paused": paused,
+            "occupied": occupied,
+            "free": free_n,
+            "alive": alive,
+            "garbage": garbage_n,
+            "fill": occupied / float(self.n),
+            "alloc_rate": round(alloc_rate, 1),
+            "freed_rate": round(freed_rate, 1),
+            "total_alloc": total_alloc,
+            "total_freed": total_freed,
+            "last_freed": last_freed,
+            "last_pause_ms": round(last_pause, 1),
