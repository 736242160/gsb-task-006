+    var d = B64_LOOKUP[str.charAt(i + 3)];
+    var n = (a << 18) | (b << 12) | (c << 6) | d;
+    out[p++] = (n >> 16) & 255;
+    out[p++] = (n >> 8) & 255;
+    out[p++] = n & 255;
+  }
+  return out;
