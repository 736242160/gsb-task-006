+function decodeColors(str) {
+  var out = new Uint8Array(Math.floor(str.length / 4) * 3);
+  var p = 0;
+  for (var i = 0; i < str.length; i += 4) {
+    var a = B64_LOOKUP[str.charAt(i)];
