+      "<span class='tdot'></span><span>" + t.name + "</span>" +
+      "<span style='color:#5a6b82'>" + (t.parked ? "parked @ safepoint" : "running") +
+      "</span><span class='ops'>" + t.ops + " ops</span></div>";
