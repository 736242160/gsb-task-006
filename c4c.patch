+function frame() {
+  var nowSec = (typeof performance !== "undefined" ? performance.now() : Date.now()) / 1000;
+  // 前端时钟与后端时戳对齐（秒级同一时基即可）
+  var renderSec = state ? (state.t + (nowSec - frame._lastLocal || 0)) : nowSec;
+  if (state) {
+    frame._lastLocal = nowSec;
+    frame._lastState = state.t;
+  }
+  var t = state ? state.t + (nowSec - (frame._clientAt || nowSec)) : nowSec;
+  drawGrid(t);
+  updateHud(t);
+  drawSpark();
+  requestAnimationFrame(frame);
+}
